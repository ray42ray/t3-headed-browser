#!/bin/bash
# t3-headed-browser: run T3 Code's server browser as a real, headed Chromium.
#
# When no desktop app is attached to a T3 Code server, the browser panel runs
# T3's bundled chrome-headless-shell, and Google refuses sign-in and sign-up from
# it. This tool swaps each installed shell for a small shim that runs a full
# Chromium-based browser, headed, on an X display such as Xvfb. The original
# binary stays beside the shim, which falls back to it when the browser or the
# display is missing.
#
# https://github.com/Tarsow/t3-headed-browser
set -euo pipefail

version=0.3.0
t3_home="${T3CODE_HOME:-$HOME/.t3}"
root="$t3_home/tools/chrome-headless-shell"
config="${XDG_CONFIG_HOME:-$HOME/.config}/t3-headed-browser/config"
extension="${config%/*}/extension"
x11="${T3_HEADED_BROWSER_X11_DIR:-/tmp/.X11-unix}"
marker="# t3-headed-browser shim"

# Real browser binaries rather than their launcher scripts, so the browser's own
# PID is the one the shim waits for in the profile lock.
candidates=(
  /opt/google/chrome/chrome
  /usr/lib/chromium/chromium
  /usr/lib/chromium-browser/chromium-browser
  /opt/brave.com/brave/brave
  /opt/microsoft/msedge/msedge
)

usage() {
  cat <<EOF
Usage: t3-headed-browser <command> [options]

Commands:
  install [--browser PATH] [--display :N] [--gpu | --gpu=NODE | --no-gpu]
              [--brand chrome | --brand brave]
              Swap every installed T3 server browser for the shim. Options are
              saved to $config
              and reused on later runs. Defaults: the first browser found
              among Chrome, Chromium, Brave and Edge, display :99, and no GPU.
              --gpu renders on a real GPU instead of SwiftShader, through the
              DRI render node NODE (default: the first /dev/dri/renderD*).
              --brand chrome reports Google Chrome in the brands a site reads
              (the default), --brand brave reports the browser's own brand.
  uninstall   Put the original chrome-headless-shell binaries back.
  status      Show the configuration and each installed shell's state.
  version     Print the version.
EOF
}

die() {
  echo "t3-headed-browser: $*" >&2
  exit 1
}

read_config() {
  browser="" display=":99" gpu="" brand=chrome
  [ -r "$config" ] || return 0
  local key value
  while IFS='=' read -r key value; do
    case $key in
      browser) browser=$value ;;
      display) display=$value ;;
      gpu) gpu=$value ;;
      brand) brand=$value ;;
    esac
  done <"$config"
}

write_config() {
  mkdir -p "$(dirname "$config")"
  printf 'browser=%s\ndisplay=%s\ngpu=%s\nbrand=%s\n' "$browser" "$display" "$gpu" "$brand" >"$config"
}

detect_browser() {
  local candidate
  for candidate in "${candidates[@]}"; do
    if [ -x "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

detect_gpu() {
  local node
  for node in "${T3_HEADED_BROWSER_DRI_DIR:-/dev/dri}"/renderD*; do
    if [ -c "$node" ] || [ -f "$node" ]; then
      echo "$node"
      return 0
    fi
  done
  return 1
}

display_up() { [ -S "$x11/X${display#:}" ]; }

shells() { find "$root" -mindepth 3 -maxdepth 3 -name chrome-headless-shell -type f 2>/dev/null | sort; }

is_shim() { [ "$(head -c 512 "$1" 2>/dev/null | tr -d '\0' | sed -n 2p)" = "$marker" ]; }

shim() {
  printf '#!/bin/bash\n%s\n' "$marker"
  # The ${...} below is shim code, written as is; only %q is filled in now.
  # shellcheck disable=SC2016
  printf 'browser=${T3_HEADED_BROWSER:-%q}\n' "$browser"
  # shellcheck disable=SC2016
  printf 'display=${T3_HEADED_BROWSER_DISPLAY:-%q}\n' "$display"
  # shellcheck disable=SC2016
  printf 'gpu=${T3_HEADED_BROWSER_GPU-%q}\n' "$gpu"
  # shellcheck disable=SC2016
  printf 'brand=${T3_HEADED_BROWSER_BRAND:-%q}\n' "$brand"
  # shellcheck disable=SC2016
  printf 'ext=%q\n' "$extension"
  cat <<'SHIM'
# T3 Code launches this file as its headless server browser. Run a full, headed
# Chromium on an X display instead. Written by t3-headed-browser
# (https://github.com/Tarsow/t3-headed-browser); do not edit.
here=$(dirname "$(readlink -f "$0")")
real="$here/chrome-headless-shell.real"
x11="${T3_HEADED_BROWSER_X11_DIR:-/tmp/.X11-unix}"
# T3's HTML previews launch the shell directly with --headless=new and render
# the agent's own pages, which need no real browser. Playwright, which runs the
# browser panel, passes plain --headless.
for arg in "$@"; do
  case $arg in --version | --headless=new) exec "$real" "$@" ;; esac
done
if [ ! -x "$browser" ] || [ ! -S "$x11/X${display#:}" ]; then
  exec "$real" "$@"
fi
# With a usable GPU render node, drop Playwright's software-only GPU flags so
# WebGL reports the real GPU rather than SwiftShader, which bot checks flag.
# Xvfb has no hardware GL, so ANGLE renders through EGL on the render node.
hw=""
[ -n "$gpu" ] && [ -r "$gpu" ] && [ -w "$gpu" ] && hw=1
args=() profile="" windowless="" blink=""
for arg in "$@"; do
  case $arg in
    --headless | --headless=* | --hide-scrollbars) continue ;;
    --disable-gpu | --enable-unsafe-swiftshader | --use-angle=* | --use-gl=*) [ -n "$hw" ] && continue ;;
    --user-data-dir=*) profile=${arg#*=} ;;
    --no-startup-window) windowless=1 ;;
    # Chromium keeps only the last copy of a switch, so merge into Playwright's.
    --disable-blink-features=*) arg="$arg,WebAuth" blink=1 ;;
  esac
  args+=("$arg")
done
[ -n "$hw" ] && args+=(--use-gl=angle --use-angle=gl-egl)
# A headed browser shows its own passkey prompt, which the panel can't show and
# which blocks the page. Without WebAuthn, sites offer other sign-in methods.
[ -n "$blink" ] || args+=(--disable-blink-features=WebAuth)
# Report Google Chrome in the brands a site can read. Brave is missing from
# Microsoft's supported-browser list for Conditional Access, and its client
# hints still say Brave even though its user agent already looks like Chrome.
# The extension also hides navigator.brave. Other extensions stay disabled.
if [ "$brand" = chrome ] && [ -f "$ext/manifest.json" ]; then
  args+=(--disable-extensions-except="$ext" --load-extension="$ext")
fi
# An inherited XAUTHORITY belongs to the inherited DISPLAY, such as a desktop
# session's file, and has no cookie for another display like Xvfb's.
if [ "${DISPLAY:-}" != "$display" ] || [ -z "${XAUTHORITY:-}" ]; then
  XAUTHORITY="$HOME/.Xauthority"
fi
export DISPLAY="$display" XAUTHORITY
if [ -n "$windowless" ] || [ -z "$profile" ]; then
  exec "$browser" "${args[@]}"
fi
# T3 opens a persistent profile, closes its first page, then opens its tab. A
# headed browser quits when its last window closes, so start it windowless,
# which keeps it running, and open the first page with a second invocation once
# the browser holds the profile lock.
"$browser" --no-startup-window "${args[@]}" &
pid=$!
trap 'kill -TERM "$pid" 2>/dev/null' TERM INT HUP
owns_lock() {
  local owner
  owner=$(readlink "$profile/SingletonLock" 2>/dev/null) || return 1
  owner=${owner##*-}
  [ "$owner" = "$pid" ] || [ "$(awk '/^PPid:/ {print $2}' "/proc/$owner/status" 2>/dev/null)" = "$pid" ]
}
for _ in $(seq 300); do
  if owns_lock; then
    "$browser" --user-data-dir="$profile" --no-first-run about:blank </dev/null >/dev/null 2>&1 3>&- 4>&-
    break
  fi
  kill -0 "$pid" 2>/dev/null || break
  sleep 0.05
done
wait "$pid"
status=$?
while kill -0 "$pid" 2>/dev/null; do
  wait "$pid"
  status=$?
done
exit "$status"
SHIM
}

# T3 launches a freshly installed shell straight away, usually before the shim
# lands, and keeps the first browser it started for later tabs. Stop a browser
# that still runs with the old shim or with the original shell, so T3's next tab
# starts through the new one. Only this T3's own profile directory is touched,
# never a browser the user opened.
restart_browser() {
  local pid exe cmd
  for pid in $(pgrep -u "$(id -u)" -f chrome-headless-shell || true) \
    $(pgrep -u "$(id -u)" -x "$(basename "$browser")" || true); do
    cmd=$(tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null) || continue
    grep -q '^--type=' <<<"$cmd" && continue
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null)
    if [ "$exe" != "$1" ] && ! grep -q -- "--user-data-dir=$t3_home/userdata/server-browser/" <<<"$cmd"; then
      continue
    fi
    kill -TERM "$pid" 2>/dev/null && echo "stopped browser $pid; T3 relaunches it through the shim"
  done
}

# The brands a site reads. Written at install time so the version in the header
# is the browser's own; Chrome's constant brand-grease value is kept.
write_extension() {
  local major
  # "Brave Browser 157.1.99.57 unknown": the version is the first dotted word.
  major=$("$browser" --version 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+\./) { print $i; exit }}' || true)
  major=${major%%.*}
  case $major in '' | *[!0-9]*) major=0 ;; esac
  mkdir -p "$extension"
  cat >"$extension/manifest.json" <<'EOF'
{
  "manifest_version": 3,
  "name": "t3-headed-browser: report Google Chrome",
  "description": "Keeps the brand a site sees in line with the Chrome-like user agent.",
  "version": "1",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "brand", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["brand.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
EOF
  cat >"$extension/rules.json" <<EOF
[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "requestHeaders": [
        {
          "header": "sec-ch-ua",
          "operation": "set",
          "value": "\"Not-A.Brand\";v=\"99\", \"Google Chrome\";v=\"$major\", \"Chromium\";v=\"$major\""
        },
        {
          "header": "sec-ch-ua-full-version-list",
          "operation": "set",
          "value": "\"Not-A.Brand\";v=\"99.0.0.0\", \"Google Chrome\";v=\"$major.0.0.0\", \"Chromium\";v=\"$major.0.0.0\""
        }
      ]
    },
    "condition": {
      "urlFilter": "*",
      "resourceTypes": ["main_frame", "sub_frame", "xmlhttprequest", "script", "stylesheet", "image", "font", "other"]
    }
  }
]
EOF
  cat >"$extension/brand.js" <<'EOF'
// Same substitution in JavaScript, where navigator.userAgentData is read. The
// lists are derived from the browser's own, so the version and the grease brand
// always match what the browser reports.
(() => {
  const real = navigator.userAgentData;
  if (!real || !Array.isArray(real.brands)) return;
  const swap = (list) =>
    list.map((b) => (b.brand === "Brave" ? { brand: "Google Chrome", version: b.version } : b));
  const fake = {
    brands: swap(real.brands),
    mobile: real.mobile,
    platform: real.platform,
    getHighEntropyValues(hints) {
      return real.getHighEntropyValues(hints).then((v) => {
        if (v.brands) v.brands = swap(v.brands);
        if (v.fullVersionList) v.fullVersionList = swap(v.fullVersionList);
        return v;
      });
    },
    toJSON() {
      return { brands: this.brands, mobile: this.mobile, platform: this.platform };
    },
  };
  Object.defineProperty(Navigator.prototype, "userAgentData", { get: () => fake, configurable: true });
  // navigator.brave is the other explicit Brave tell.
  Object.defineProperty(Navigator.prototype, "brave", { value: undefined, configurable: true });
})();
EOF
}

cmd_install() {
  read_config
  while [ $# -gt 0 ]; do
    case $1 in
      --browser) [ $# -ge 2 ] || die "--browser needs a path"; browser=$2; shift 2 ;;
      --browser=*) browser=${1#*=}; shift ;;
      --display) [ $# -ge 2 ] || die "--display needs a value like :99"; display=$2; shift 2 ;;
      --display=*) display=${1#*=}; shift ;;
      --gpu) gpu=$(detect_gpu) || die "no GPU render node under ${T3_HEADED_BROWSER_DRI_DIR:-/dev/dri}; pass --gpu=NODE"; shift ;;
      --gpu=*) gpu=${1#*=}; shift ;;
      --no-gpu) gpu=""; shift ;;
      --brand) [ $# -ge 2 ] || die "--brand needs chrome or brave"; brand=$2; shift 2 ;;
      --brand=*) brand=${1#*=}; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  if [ -z "$browser" ]; then
    browser=$(detect_browser) || die "no Chromium-based browser found; pass --browser PATH"
  fi
  [ -x "$browser" ] || die "not executable: $browser"
  case $display in
    :[0-9]*) ;;
    *) die "display must look like :99, got '$display'" ;;
  esac
  [ -z "$gpu" ] || [ -e "$gpu" ] || die "no such GPU render node: $gpu"
  case $brand in
    chrome | brave) ;;
    *) die "brand must be chrome or brave, got '$brand'" ;;
  esac
  write_config
  write_extension
  [ -z "$gpu" ] || { [ -r "$gpu" ] && [ -w "$gpu" ]; } || echo "warning: $gpu isn't readable and writable by $(id -un); the shim keeps software rendering until it is (add the user to the render group)" >&2
  display_up || echo "warning: no X server on $display yet; the shim uses the headless shell until one runs" >&2

  local exe found=""
  while IFS= read -r exe; do
    found=1
    if is_shim "$exe"; then
      shim >"$exe.new"
      chmod 755 "$exe.new"
      # Shims only apply at launch, so stop a browser that runs an older one.
      mv -f "$exe.new" "$exe"
      restart_browser "$exe.real"
      continue
    fi
    mv "$exe" "$exe.real"
    shim >"$exe"
    chmod 755 "$exe"
    echo "shimmed $exe"
    restart_browser "$exe.real"
  done < <(shells)
  [ -n "$found" ] || echo "no T3 server browser under $root yet; run install again after T3 downloads it"
}

cmd_uninstall() {
  local exe
  rm -rf "$extension"
  while IFS= read -r exe; do
    is_shim "$exe" || continue
    if [ -x "$exe.real" ]; then
      mv -f "$exe.real" "$exe"
      echo "restored $exe"
    fi
  done < <(shells)
}

cmd_status() {
  read_config
  echo "browser: ${browser:-not configured}"
  if display_up; then echo "display: $display (running)"; else echo "display: $display (not running)"; fi
  if [ -z "$gpu" ]; then echo "gpu: off (SwiftShader)"
  elif [ -r "$gpu" ] && [ -w "$gpu" ]; then echo "gpu: $gpu"
  else echo "gpu: $gpu (not accessible; using SwiftShader)"; fi
  if [ "$brand" = chrome ]; then echo "brand: Google Chrome (Brave's own brand is hidden)"
  else echo "brand: the browser's own"; fi
  local exe found=""
  while IFS= read -r exe; do
    found=1
    if is_shim "$exe"; then echo "shimmed:  $exe"; else echo "original: $exe"; fi
  done < <(shells)
  [ -n "$found" ] || echo "no T3 server browser under $root"
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  uninstall) cmd_uninstall ;;
  status) cmd_status ;;
  version | --version) echo "t3-headed-browser $version" ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 2 ;;
esac
